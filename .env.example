APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SSO FEN (Keycloak)
KEYCLOAK_BASE_URL=https://sso-dev.fen.uchile.cl
KEYCLOAK_REALM=FenUChile
KEYCLOAK_CLIENT_ID=SGP-local
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:8000/signin-oidc
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=

# Webdox CLM (API v2). Complete usuario y clave; no se sube a GitHub
WEBDOX_BASE_URL=https://api.webdoxclm.com/api/v2
WEBDOX_USERNAME=
WEBDOX_PASSWORD=
WEBDOX_CUSTOMER=

# Carpeta compartida con los Excel de certificados de pago
WEBDOX_CERTIFICADOS_DIR=

# Correos con acceso completo a SGP-FEN (separados por coma). El resto solo ve «Mis cobros» si tiene centros de costo asignados.
SGP_ADMINS=mcuadra@fen.uchile.cl
